{
  "home": {
    "username": "YOUR-USER-NAME",
    "homeDirectory": "/home/YOUR-USER-NAME",
    "stateVersion": "26.05"
  },
  "programs": {
    "home-manager": {
      "enable": true
    }
  },
  "services": {
    "eznix": {
      "enable": true,
      "passwordFile": "/home/YOUR-USER-NAME/.config/eznix-password",
      "enableHttps": {
        "_disabled": true,
        "_value": true
      },
      "trustCert": {
        "_disabled": true,
        "_value": true
      },
      "buttons": [
        {
          "label": "List",
          "description": "Shows the earlier versions of your setup",
          "command": "home-manager generations",
          "separator": "after"
        },
        {
          "label": "Activate",
          "description": "Puts your changes to use on this computer",
          "command": "home-manager switch --flake \"$HOME/.config/home-manager#default\"",
          "save_first": true
        },
        {
          "label": "Update",
          "description": "Fetches newer versions of your programs. Press Activate after it",
          "command": "nix flake update --flake ~/.config/home-manager"
        },
        {
          "label": "Cleanup",
          "description": "Removes the earlier versions of your setup to free disk space",
          "command": "nix-collect-garbage -d"
        }
      ]
    }
  }
}
