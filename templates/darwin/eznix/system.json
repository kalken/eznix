{
  "nixpkgs": {
    "hostPlatform": "aarch64-darwin"
  },
  "nix": {
    "enable": false
  },
  "system": {
    "primaryUser": "YOUR-USER-NAME",
    "stateVersion": 7
  },
  "services": {
    "eznix": {
      "enable": true,
      "flake": "~/.config/nix-darwin",
      "enableHttps": {
        "_disabled": true,
        "_value": true
      },
      "trustCert": {
        "_disabled": true,
        "_value": true
      },
      "buttons": [
        {
          "label": "List Generations",
          "command": "sudo darwin-rebuild --list-generations"
        },
        {
          "label": "Create Generation",
          "command": "sudo darwin-rebuild switch --flake \"$HOME/.config/nix-darwin#default\"",
          "save_first": true
        },
        {
          "label": "Clear Generations",
          "command": "sudo nix-collect-garbage -d"
        },
        {
          "label": "Update Flake",
          "command": "nix flake update --flake ~/.config/nix-darwin"
        },
        {
          "label": "Generate Autocomplete",
          "command": "eznix-autocomplete"
        }
      ]
    }
  }
}
