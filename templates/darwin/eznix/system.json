{
  "nixpkgs": {
    "hostPlatform": "aarch64-darwin"
  },
  "nix": {
    "enable": false
  },
  "system": {
    "primaryUser": "YOUR-USER-NAME",
    "stateVersion": 7
  },
  "services": {
    "eznix": {
      "enable": true,
      "flake": "~/.config/nix-darwin",
      "enableHttps": {
        "_disabled": true,
        "_value": true
      },
      "trustCert": {
        "_disabled": true,
        "_value": true
      },
      "buttons": [
        {
          "label": "List",
          "description": "Shows the earlier versions of your system",
          "command": "sudo darwin-rebuild --list-generations",
          "separator": "after"
        },
        {
          "label": "Activate",
          "description": "Puts your changes to use on this computer",
          "command": "sudo darwin-rebuild switch --flake \"$HOME/.config/nix-darwin#default\"",
          "save_first": true
        },
        {
          "label": "Update",
          "description": "Fetches newer versions of your programs. Press Activate after it",
          "command": "nix flake update --flake ~/.config/nix-darwin"
        },
        {
          "label": "Cleanup",
          "description": "Removes the earlier versions of your system to free disk space",
          "command": "sudo nix-collect-garbage -d"
        }
      ]
    }
  }
}
