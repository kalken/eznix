{
  "nix": {
    "settings": {
      "experimental-features": [
        "nix-command",
        "flakes"
      ]
    }
  },
  "services": {
    "eznix": {
      "enable": true,
      "users": [
        "YOUR-USER-NAME"
      ],
      "enableHttps": {
        "_disabled": true,
        "_value": true
      },
      "trustCert": {
        "_disabled": true,
        "_value": true
      },
      "buttons": [
        {
          "label": "List",
          "description": "Shows the earlier versions of your system",
          "command": "nixos-rebuild list-generations",
          "separator": "after"
        },
        {
          "label": "Activate",
          "description": "Puts your changes to use on this computer",
          "command": "sudo nixos-rebuild switch --flake \"/etc/nixos#default\"",
          "save_first": true
        },
        {
          "label": "Update",
          "description": "Fetches newer versions of your programs. Press Activate after it",
          "command": "sudo nix flake update --flake /etc/nixos"
        },
        {
          "label": "Cleanup",
          "description": "Removes the earlier versions of your system to free disk space",
          "command": "sudo nix-collect-garbage -d && sudo /run/current-system/bin/switch-to-configuration boot"
        }
      ],
      "plugins": {
        "system": {
          "generate": [
            {
              "file": "hardware-configuration.nix",
              "command": "sudo sh -c 'nixos-generate-config --show-hardware-config --no-filesystems > hardware-configuration.nix'"
            }
          ]
        }
      }
    }
  }
}
