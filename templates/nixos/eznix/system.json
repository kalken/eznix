{
  "nix": {
    "settings": {
      "experimental-features": [
        "nix-command",
        "flakes"
      ]
    }
  },
  "services": {
    "eznix": {
      "enable": true,
      "users": [
        "YOUR-USER-NAME"
      ],
      "enableHttps": {
        "_disabled": true,
        "_value": true
      },
      "trustCert": {
        "_disabled": true,
        "_value": true
      },
      "buttons": [
        {
          "label": "List Generations",
          "command": "nixos-rebuild list-generations"
        },
        {
          "label": "Create Generation",
          "command": "sudo nixos-rebuild switch --flake \"/etc/nixos#default\"",
          "save_first": true
        },
        {
          "label": "Clear Generations",
          "command": "sudo nix-collect-garbage -d"
        },
        {
          "label": "Update Flake",
          "command": "sudo nix flake update --flake /etc/nixos"
        },
        {
          "label": "Generate Autocomplete",
          "command": "eznix-autocomplete"
        }
      ]
    }
  }
}
